# Database Configuration
MONGODB_URI=mongodb://localhost:27017/rentright

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_s3_bucket_name

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback

# DocuSign Configuration
DOCUSIGN_CLIENT_ID=your_docusign_client_id
DOCUSIGN_CLIENT_SECRET=your_docusign_client_secret
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
DOCUSIGN_USER_ID=your_docusign_user_id
DOCUSIGN_PRIVATE_KEY_PATH=path/to/your/private_key.pem

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Session Configuration
SESSION_SECRET=your_session_secret

# Frontend URL
FRONTEND_URL=http://localhost:3000
# For production, set this to your S3 website URL:
# FRONTEND_URL=http://rentright-website-statick-files.s3-website.ca-central-1.amazonaws.com

# Server Configuration
DEV_BACKEND_PORT=5000
NODE_ENV=development

# AWS S3 Configuration
AWS_S3_BUCKET=rentright-data

# Email Configuration (if using email features)
EMAIL_SERVICE=gmail

# OpenAI Configuration (if using AI features)
OPENAI_API_KEY=your_openai_api_key

# DocuSign Configuration (if using DocuSign features)
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
DOCUSIGN_USER_ID=your_docusign_user_id
DOCUSIGN_PRIVATE_KEY_PATH=path/to/your/private_key.pem

# AWS Elastic Beanstalk Configuration
AWS_BACKEND_PORT=8080
NODE_ENV=production

# For AWS deployment, make sure these are set in your Elastic Beanstalk environment:
# FRONTEND_URL=http://rentright-website-statick-files.s3-website.ca-central-1.amazonaws.com
# NODE_ENV=production
# AWS_BACKEND_PORT=8080 